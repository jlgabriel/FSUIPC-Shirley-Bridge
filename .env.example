# FSUIPC-Shirley-Bridge Configuration
# Copy this file to .env and adjust values as needed

# ===== FSUIPC Connection =====
# WebSocket URL for FSUIPC server
FSUIPC_WS_URL=ws://localhost:2048/fsuipc/

# ===== Shirley WebSocket Server =====
# Host to bind the Shirley WebSocket server
WS_HOST=localhost

# Port for Shirley WebSocket server
WS_PORT=2992

# WebSocket path (for logging/display only)
WS_PATH=/api/v1

# ===== Data Transmission =====
# Interval in seconds for sending data (default: 0.25 = 4 Hz)
SEND_INTERVAL=0.25

# Publish COM/NAV frequencies (true/false, default: false)
#
# Shirley rejects them — "radiosNavigation: Unrecognized key(s) in object:
# 'frequencyHz', 'standbyFrequencyHz'" — even though the published
# sim-interface schema defines both in v2.12 and v2.13, so the deployed Shirley
# runs an older schema. Every group is .strict(), so sending them invalidates
# the whole radiosNavigation group and the transponder code is lost with it.
#
# Set to true once Shirley accepts them. The frequencies are read either way,
# and they can still be set from Shirley; they are only left out of the feed.
PUBLISH_RADIO_FREQUENCIES=false

# ===== Logging =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Path to log file (if not set, logs only to console)
# LOG_FILE=fsuipc_shirley_bridge.log

# ===== Debug =====
# Enable detailed FSUIPC message debugging (true/false)
DEBUG_FSUIPC_MESSAGES=false
